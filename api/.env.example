# Obrigatoria — fica SOMENTE no servidor; nunca distribua no app.
GITHUB_TOKEN=github_pat_cole_aqui_o_fine_grained_pat

# Opcionais
GITHUB_REPO=AC-Tech-Pro-Oficial/GoLiveBypassEnhanced
# Labels precisam existir no repo. Crie "gui" uma vez (Settings → Labels).
ISSUE_LABELS=bug,gui
PORT=8080
# Rate limit agressivo: quantos requests por minuto por IP (janela de 1min).
# Estourar a janela BLOQUEIA o IP por BLOCK_SECONDS.
RATE_LIMIT=3
BLOCK_SECONDS=600
MAX_LOG_BYTES=262144
LOG_LEVEL=info
# Prefixo de rota quando a API fica atras de um proxy por path (ex.: /bugs).
# Vazio = servir na raiz.
BASE_PATH=

# /v1/reports e deliberadamente publico: um token embutido no cliente desktop seria
# extraivel e nao forneceria autenticacao real. Abuse protection = body/meta limits +
# rate limit/bloqueio por IP. O GITHUB_TOKEN acima nunca sai do servidor.
